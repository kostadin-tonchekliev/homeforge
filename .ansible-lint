---
# Ansible-lint configuration file
# Reference: https://docs.ansible.com/projects/lint/

skip_list:
  - name[casing]

warn_list:
  - risky-file-permissions

exclude_paths:
  - .git
  - .github
  - .venv
  - docker
  - .yamllint
  - .ansible-lint
  - inventory/group_vars/prod/vault.yml  # Ansible Vault ciphertext
