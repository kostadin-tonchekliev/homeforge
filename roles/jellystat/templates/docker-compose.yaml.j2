services:
  # Database lives on the shared PostgreSQL server (/opt/postgres), database "jfstat", role "jellystat".
  # The old private jellystat-db (Postgres 18.1, data in /opt/jellystat/db) was retired on 2026-10-11.
  jellystat:
    image: cyfershepard/jellystat:latest
    container_name: jellystat
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-file: "5"
        max-size: "10m"
    environment:
      POSTGRES_USER: jellystat
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_IP: postgres
      POSTGRES_PORT: 5432
      POSTGRES_DB: jfstat
      JWT_SECRET: "my-secret-jwt-key"
      TZ: {{ homeserver_timezone }} # timezone (ex: Europe/Paris)
    volumes:
      - /opt/jellystat/data:/app/backend/backup-data
    ports:
      - "3005:3000"
    networks:
      - default
      - proxy
      - db
    healthcheck:
      test: wget --no-verbose --tries=1 --spider http://localhost:3000/auth/isConfigured || exit 1
      interval: 60s
      timeout: 30s
      retries: 5
      start_period: 30s

networks:
  default:
  proxy:
    external: true
  db:
    external: true
