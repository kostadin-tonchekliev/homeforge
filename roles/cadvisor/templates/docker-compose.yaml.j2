---
services:
  cadvisor:
    container_name: cadvisor
    image: gcr.io/cadvisor/cadvisor:latest
    # Localhost only: Prometheus scrapes localhost:8080, the UI goes through Caddy
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - "/:/rootfs"
      - "/var/run:/var/run"
      - "/sys:/sys"
      - "/var/lib/docker/:/var/lib/docker"
      - "/dev/disk/:/dev/disk"
    networks:
      - proxy
    restart: unless-stopped

networks:
   proxy:
     external: true
