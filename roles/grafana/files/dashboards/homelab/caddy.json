    {
      "id": 15,
      "type": "timeseries",
      "title": "p95 latency by service",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(histogram_quantile(0.95, sum by (le, host) (rate(caddy_http_request_duration_seconds_bucket{host=~\"$host\", host!=\"_other\"}[$__rate_interval]))), \"service\", \"$1\", \"host\", \"([^.]+)\\\\..*\")",
          "legendFormat": "{{service}}"
        }
