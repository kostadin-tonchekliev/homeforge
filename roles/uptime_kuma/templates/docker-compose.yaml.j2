---
services:
   uptime-kuma:
     image: louislam/uptime-kuma:2
     container_name: uptime-kuma
     restart: always
     ports:
       - "3001:3001"
     volumes:
       - /var/run/docker.sock:/var/run/docker.sock
       - /opt/uptime-kuma/data:/app/data
     extra_hosts:
       - host.docker.internal:host-gateway
     networks:
       - proxy

networks:
   proxy:
     external: true
