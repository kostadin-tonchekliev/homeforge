---
services:
  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID=0
      - PGID=0
      - TZ={{ homeserver_timezone }}
      # Database: shared PostgreSQL server (/opt/postgres), password in .env
      - RADARR__POSTGRES__HOST=postgres
      - RADARR__POSTGRES__PORT=5432
      - RADARR__POSTGRES__USER=radarr
      - RADARR__POSTGRES__PASSWORD=${POSTGRES_PASSWORD}
      - RADARR__POSTGRES__MAINDB=radarr-main
      - RADARR__POSTGRES__LOGDB=radarr-log
    volumes:
      - /opt/radarr/config:/config
      - /media:/media
    ports:
      - 7878:7878
    networks:
      - arr_network
      - proxy
      - db
    restart: unless-stopped

networks:
   arr_network:
     external: true
   proxy:
     external: true
   db:
     external: true
