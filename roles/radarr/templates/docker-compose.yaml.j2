---
services:
  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      # Shared by everything that touches /media (Deluge, Sonarr, Radarr, Jellyfin): the
      # server user, group media, umask 002 -> files and folders stay group-writable
      - PUID={{ homeserver_uid }}
      - PGID={{ homeserver_media_gid }}
      - UMASK=002
      # Hostnames Radarr answers to (it refuses others, against DNS rebinding): the Caddy
      # URL, the container name other apps and Homepage use, and the LAN IP (published port)
      - RADARR__SERVER__ALLOWEDHOSTS={{ homelab_services.radarr.subdomain }}.{{ homeserver_domain }},radarr,{{ homeserver_lan_ip }}
      - TZ={{ homeserver_timezone }}
      # Database: shared PostgreSQL server (/opt/postgres), password in .env
      - RADARR__POSTGRES__HOST=postgres
      - RADARR__POSTGRES__PORT=5432
      - RADARR__POSTGRES__USER=radarr
      - RADARR__POSTGRES__PASSWORD=${POSTGRES_PASSWORD}
      - RADARR__POSTGRES__MAINDB=radarr-main
      - RADARR__POSTGRES__LOGDB=radarr-log
    volumes:
      - /opt/radarr/config:/config
      - /media:/media
    ports:
      - 7878:7878
    networks:
      - arr_network
      - proxy
      - db
    restart: unless-stopped

networks:
   arr_network:
     external: true
   proxy:
     external: true
   db:
     external: true
