---
services:
  jellyfin:
    image: {{ jellyfin_image }}
    container_name: jellyfin
    # Host networking: LAN clients and discovery (7359/udp) reach Jellyfin on the server's
    # own IP, and Caddy proxies to host.docker.internal:8096 — no NAT in the streaming path
    network_mode: host
    # Same user and group (media) as Deluge, Sonarr and Radarr, so everything under /media
    # is readable and writable by all of them
    user: "{{ homeserver_uid }}:{{ homeserver_media_gid }}"
    # GPU access for hardware transcoding: the host's video and render groups, by number
    group_add:
{% for gid in jellyfin_gpu_gids %}
      - "{{ gid }}"
{% endfor %}
    # umask 002: subtitles/metadata Jellyfin writes next to the media stay group-writable
    entrypoint: ["/bin/sh", "-c", "umask 002 && exec /jellyfin/jellyfin"]
    environment:
      - TZ={{ homeserver_timezone }}
      # The paths the old apt install used, so the paths stored in Jellyfin's database
      # and plugin configs stay valid
      - JELLYFIN_DATA_DIR=/var/lib/jellyfin
      - JELLYFIN_CONFIG_DIR=/etc/jellyfin
      - JELLYFIN_CACHE_DIR=/var/cache/jellyfin
      - JELLYFIN_LOG_DIR=/var/log/jellyfin
    volumes:
      - /opt/jellyfin/data:/var/lib/jellyfin
      - /opt/jellyfin/config:/etc/jellyfin
      - /opt/jellyfin/cache:/var/cache/jellyfin
      - /opt/jellyfin/log:/var/log/jellyfin
      - /media:/media
{% if jellyfin_devices | length > 0 %}
    devices:
{% for device in jellyfin_devices %}
      - {{ device }}:{{ device }}
{% endfor %}
{% endif %}
    restart: unless-stopped
