# Generated by roles/redis (homeserver_redis_dbs); redis reads it at start.
# Without a login only PING works (the healthcheck). Passwords are stored as SHA-256 hashes.
user default on nopass resetchannels -@all +ping
# redis-exporter: server stats only, no keys and no channels
user exporter on #{{ redis_exporter_password | hash('sha256') }} resetchannels -@all +@connection +info +config|get +client +slowlog +latency +memory
{% for user, db in homeserver_redis_dbs.items() %}
# {{ user }}: database {{ db }}. No admin commands, and no FLUSHALL, which would empty
# the other apps' databases too.
user {{ user }} on #{{ redis_app_passwords[user] | hash('sha256') }} ~* &* +@all -@admin -flushall
{% endfor %}
