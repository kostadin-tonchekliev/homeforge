---
services:
  redis:
    image: redis:latest
    container_name: redis
    restart: unless-stopped
    # Users and passwords come from conf/users.acl (generated by roles/redis)
    command: redis-server --aclfile /usr/local/etc/redis/users.acl
    labels:
      # Redis reads the ACL file only at start: a change of users recreates the container
      homeforge.users-acl: "{{ lookup('ansible.builtin.template', 'users.acl.j2') | hash('sha256') }}"
    environment:
      TZ: {{ homeserver_timezone }}
    volumes:
      # RDB snapshots
      - /opt/redis/data:/data
      # A folder, not the file: a single-file mount goes stale when the file is replaced
      - /opt/redis/conf:/usr/local/etc/redis:ro
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    # No published port: apps reach it as redis:6379 over db
    networks:
      - db

  # Prometheus metrics -> Grafana "Redis" dashboard
  redis-exporter:
    image: oliver006/redis_exporter:latest
    container_name: redis-exporter
    environment:
      REDIS_ADDR: redis://redis:6379
      REDIS_USER: exporter
      REDIS_PASSWORD: ${EXPORTER_PASSWORD}
    # No published port: Prometheus scrapes redis-exporter:9121 over the db network
    depends_on:
      redis:
        condition: service_healthy
    networks:
      - db
    restart: unless-stopped

networks:
  db:
    external: true
