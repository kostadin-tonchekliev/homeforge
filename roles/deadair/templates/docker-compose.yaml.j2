---
services:
  deadair:
    # "latest" bundles the speech server (a CPU voice) and expects our own database and cache.
    # It's built for amd64 only: on an arm64 box (the Mac sandbox) it runs under emulation.
    image: deadair/deadair:latest
    platform: linux/amd64
    container_name: deadair
    restart: unless-stopped
    environment:
      TZ: {{ homeserver_timezone }}
      # Database: shared PostgreSQL server (/opt/postgres), database and login "deadair".
      # Migrations run as this login on every start; the app_user role they grant to is
      # created by roles/postgres, so the login needs no CREATEROLE.
      DATABASE_HOST: postgres
      DATABASE_PORT: 5432
      DATABASE_NAME: deadair
      DATABASE_USER: deadair
      DATABASE_PASSWORD: ${DATABASE_PASSWORD}
      # Sessions: shared Redis server (/opt/redis), user "deadair" and its own database index
      REDIS_URL: ${REDIS_URL}
      # Served by Caddy at https://radio.{{ homeserver_domain }}: the Spotify authorization and
      # sign-in links come back to this address
      APP_BASE_URL: https://radio.{{ homeserver_domain }}
      SPA_BASE_URL: https://radio.{{ homeserver_domain }}
      # Read the listener's address from Caddy's X-Forwarded-For, or every listener is Caddy
      REAL_IP_FROM: {{ homeserver_caddy_ip }}
    # No published ports: Caddy reaches the console, the API and /live.mp3 on port 80 over
    # proxy. The live input (8006, for a presenter's encoder) isn't needed.
    volumes:
      # Settings, presenters, recordings, logs and the generated keys (data/secrets), plus the
      # records cached ahead of air and the voice weights, since no /media is mounted
      - /opt/deadair/data:/data
    healthcheck:
      # The image declares its own; this only shortens the interval for a first boot
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s
    networks:
      - default
      - proxy
      - db

networks:
  default:
  proxy:
    external: true
  db:
    external: true
